{
  "name": "magnon-monorepo",
  "version": "0.1.7",
  "private": true,
  "description": "High-throughput Rust TypeScript/JSX compiler, batch transformer, and Vite plugin monorepo",
  "scripts": {
    "prepare": "node scripts/build.js",
    "build": "node scripts/build.js",
    "build:debug": "node scripts/build.js --debug",
    "test": "cargo test --all && node test/test_package.js",
    "bench": "node benchmarks/run_benchmark.js",
    "bench:rust": "cargo run --release -p magnon-bench",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aminfathullah/magnon.git"
  },
  "author": "Amin Fathullah <amin_fathullah@yahoo.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@rspack/core": "^1.2.5",
    "@swc/core": "^1.10.18",
    "esbuild": "^0.25.0",
    "oxc-transform": "^0.54.0",
    "three": "^0.186.1"
  },
  "packageManager": "pnpm@10.27.0"
}
